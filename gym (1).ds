		menu
		{
			space Space
			{
				displayname = "space"
				icon = "tech-desktop"

				section Home
				{
					displayname = "Home"
					icon = "ui-1-home-minimal"
					page Home
					{
						icon = "users-2-home"
					}
				}
				section All_Inventory
				{
					displayname = "All Inventory"
					icon = "ui-3-playlist"
					report All_Inventories
					{
						icon = "design-bullet-list-67"
					}
				}
				section Inventory_Category
				{
					displayname = "Inventory Category"
					icon = "business-chart-pie-36"
